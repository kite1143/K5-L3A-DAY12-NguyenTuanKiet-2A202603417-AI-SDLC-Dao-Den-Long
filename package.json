{
  "name": "dao-den-long",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dao Den Long - game 3D (AI SDLC Lab Day 12)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:core": "esbuild src/core/index.ts --bundle --format=esm --platform=neutral --outfile=dist/core/index.js",
    "build:headless": "esbuild src/headless/main.ts --bundle --format=esm --platform=node --outfile=dist/headless/main.js",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:core && npm run build:headless && npm run build:web",
    "headless": "node dist/headless/main.js",
    "dev": "vite",
    "start": "vite preview --port 5173 --strictPort",
    "test": "npm run build:core && node --test tests/",
    "verify": "node scripts/verify.mjs",
    "assets": "node scripts/fetch-assets.mjs",
    "bench": "node scripts/bench.mjs",
    "soak": "node --expose-gc --max-old-space-size=160 --max-semi-space-size=2 scripts/soak.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.180.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.49.0",
    "polyfork": "^0.1.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
